#!/bin/zsh

set -u
umask 077

RUNTIME_ROOT="$HOME/Library/Application Support/KSI Local Studio/runtime"
PYTHON_BIN="$RUNTIME_ROOT/venv/bin/python"
PROJECT_SRC="$RUNTIME_ROOT/src"
LOG_DIR="$HOME/Library/Logs/KSI Local Studio"
export PYTHONDONTWRITEBYTECODE=1

if [[ "$(/usr/bin/uname -m)" != "arm64" ]]; then
  /usr/bin/osascript -e \
    'display alert "KSI Local Studio açılamadı" message "Bu kişisel paket yalnız Apple Silicon (ARM64) Mac için hazırlanmıştır." as critical'
  exit 1
fi

if [[ ! -x "$PYTHON_BIN" || ! -d "$PROJECT_SRC/ksi_local" ]]; then
  /usr/bin/osascript -e \
    'display alert "KSI Local Studio açılamadı" message "Uygulama çalışma ortamı eksik. KSI Local Studio kurulumunu yeniden çalıştırın." as critical'
  exit 1
fi

if [[ "$($PYTHON_BIN -c 'import platform; print(platform.machine())' 2>/dev/null)" != "arm64" ]]; then
  /usr/bin/osascript -e \
    'display alert "KSI Local Studio açılamadı" message "Python çalışma ortamı ARM64 değil. KSI Local Studio kurulumunu yeniden çalıştırın." as critical'
  exit 1
fi

/bin/mkdir -p "$LOG_DIR"
/bin/chmod 700 "$LOG_DIR"
/usr/bin/touch "$LOG_DIR/launch.log"
/bin/chmod 600 "$LOG_DIR/launch.log"
export PYTHONPATH="$PROJECT_SRC"
export PYTHONNOUSERSITE=1
export PATH="/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin"
export KSI_IDENTITY_FILE="$RUNTIME_ROOT/workspace-id.json"
export KSI_TOOL_MANIFEST="$RUNTIME_ROOT/config/tool-manifest.json"
export OLLAMA_NO_CLOUD=true
export HF_HUB_OFFLINE=1
export HF_DATASETS_OFFLINE=1
export TRANSFORMERS_OFFLINE=1
export NO_PROXY="127.0.0.1,localhost,::1"
exec "$PYTHON_BIN" -m ksi_local.gui >"$LOG_DIR/launch.log" 2>&1
